{
  "manifest_version": 3,
  "name": "History",
  "version": "1.0.0",
  "description": "Compact chronological history as a popup.",
  "permissions": [
    "history",
    "sessions",
    "tabs"
  ],
  "action": {
    "default_title": "History",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
